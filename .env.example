# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remote_coding_agent

# AI Assistants
# Claude - Choose one:
CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...
# OR
# CLAUDE_API_KEY=sk-ant-...

# Codex Authentication (get from ~/.codex/auth.json after running 'codex login')
# Required if using Codex as AI assistant
# On Linux/Mac: cat ~/.codex/auth.json
# On Windows: type %USERPROFILE%\.codex\auth.json
CODEX_ID_TOKEN=eyJ...
CODEX_ACCESS_TOKEN=eyJ...
CODEX_REFRESH_TOKEN=rt_...
CODEX_ACCOUNT_ID=6a6a7ba6-...

# Default AI Assistant (claude | codex)
# Used for new conversations when no codebase specified
DEFAULT_AI_ASSISTANT=claude

# GitHub Token (for GitHub CLI and commands)
GH_TOKEN=ghp_...
GITHUB_TOKEN=ghp_...  # Same as GH_TOKEN, used by adapter

# GitHub Webhooks
WEBHOOK_SECRET=your_random_secret_string

# Agent Callsign (mention trigger for platform comments)
# Default: remote-agent (GitHub adapter adds @ prefix automatically)
# Examples: jarvis, assistant, bot
# Note: No @ prefix needed - GitHub adapter adds it internally
CALLSIGN=remote-agent

# Platforms
TELEGRAM_BOT_TOKEN=<from @BotFather>

# Platform Streaming Mode (stream | batch)
TELEGRAM_STREAMING_MODE=stream  # stream (default) | batch
GITHUB_STREAMING_MODE=batch     # batch (default) | stream

# Optional
WORKSPACE_PATH=./workspace  # Host path for Docker volume mount (default: ./workspace)

# PostgreSQL Data Volume
# Controls where PostgreSQL stores database files
# Default: postgres_data (Docker named volume - recommended for most cases)
# Custom path: Set to a directory path for bind mount (e.g., ./data/postgres-dev)
# Use case: Running multiple separate database containers with isolated data
# Example: POSTGRES_DATA_VOLUME=./data/postgres-dev
POSTGRES_DATA_VOLUME=postgres_data

# Docker Container Name
# Sets the name of the Docker container for easy identification and management
# Default: remote-agent-app
# Use case: Running multiple instances with different configs (dev, staging, prod)
# Example: CONTAINER_NAME=remote-agent-dev
CONTAINER_NAME=remote-agent-app

# Port Configuration
# This port affects:
# - Docker container internal port
# - Docker host-to-container port mappings
# - Caddy reverse proxy configuration
# Default: 3000
# Important: When running multiple instances, each should use a different port
PORT=3000

# Multi-Instance Setup Example:
# Instance 1: .env (PORT=3000, CONTAINER_NAME=remote-agent-app)
# Instance 2: .env.dev (PORT=3001, CONTAINER_NAME=remote-agent-dev)

# Concurrency
MAX_CONCURRENT_CONVERSATIONS=10  # Maximum concurrent AI conversations (default: 10)
